# Exemplo de ambiente do perfilai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/perfilai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

PERFILAI_ADMIN_KEY=
PERFILAI_CAKTO_SEGREDO=
PERFILAI_CHECKOUT_MENSAL=
PERFILAI_CORTAI_ADMIN_KEY=
PERFILAI_DEMO_SENHA=
PERFILAI_HERMES_KEY=
PERFILAI_LLM_KEY=
PERFILAI_PN_TOKEN=
PERFILAI_SEGREDO_SESSAO=
PERFILAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
